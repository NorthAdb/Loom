# Runtime environment; switch to "prod" in production
LOOM_ENV=dev

# Log level: debug, info, warning, error
LOOM_LOG_LEVEL=info

# Data directory; logs, audit, notes, and checkpoints live under it
LOOM_DATA_DIR=

# Sandbox root every file op is jailed to (default ./sandbox)
LOOM_SANDBOX_ROOT=

# Sandbox service URL, e.g. http://127.0.0.1:8765; empty means the local in-process jail
LOOM_SANDBOX_URL=

# Required for loom chat: LLM provider API key
LLM_API_KEY=

# Optional: chat model name (default gpt-4o-mini)
LLM_MODEL=

# Optional: OpenAI-compatible endpoint; empty means the OpenAI default
LLM_BASE_URL=

# Memory: false turns the semantic (Mem0) layer off; the facts table keeps working
LOOM_MEMORY_ENABLED=true

# Memory entries injected per turn, facts first
LOOM_MEMORY_INJECT_LIMIT=5

# Calendar: read-only ICS feed URL (e.g. a Google Calendar "secret iCal address");
# empty disables the calendar tools
LOOM_ICAL_URL=

# Mail drafts over IMAP (there is no send path): server, port, user, app password,
# and the drafts folder; empty host disables the mail tools
LOOM_IMAP_HOST=
LOOM_IMAP_PORT=
LOOM_MAIL_USER=
LOOM_MAIL_PASSWORD=
LOOM_MAIL_FOLDER=

# IANA timezone for calendar windows and summaries (default Asia/Hong_Kong)
LOOM_TIMEZONE=

# Extra hosts (comma-separated) browser_open may visit; loopback is always allowed, empty means loopback only
LOOM_BROWSER_ALLOWED_HOSTS=

# Daily token budget braking chat turns and routine runs; 0 = unlimited
LOOM_DAILY_BUDGET_TOKENS=

# loom stats dollar estimate only: today's tokens / 1000 * this price; 0 = no estimate
LOOM_TOKEN_PRICE_USD_PER_1K=
